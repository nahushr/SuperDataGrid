{
  "name": "@simplishelf/super-data-grid",
  "version": "0.3.10",
  "description": "A plug-and-play React data grid with server-side data, saved views, filters, and custom cells.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahushr/SuperDataGrid.git"
  },
  "homepage": "https://github.com/nahushr/SuperDataGrid#readme",
  "bugs": {
    "url": "https://github.com/nahushr/SuperDataGrid/issues"
  },
  "keywords": [
    "react",
    "data-grid",
    "data-table",
    "mui",
    "server-side-pagination",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev:example": "npm run build && npm run dev --workspace super-data-grid-example",
    "build:example": "npm run build --workspace super-data-grid-example",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "workspaces": [
    "examples"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^8.17.0",
    "@mui/x-date-pickers": "^7.0.0",
    "@simplishelf/opscards": "^0.2.3",
    "@simplishelf/polyform": "^0.1.8",
    "react-hook-form": "^7.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^8.17.0",
    "@mui/x-date-pickers": "^7.0.0",
    "@simplishelf/polyform": "file:../polyform",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "jsdom": "^26.1.0",
    "react-hook-form": "^7.49.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.11",
    "write-excel-file": "^4.1.1"
  }
}
